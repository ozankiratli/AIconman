# Development only: every secret LMconman needs, kept out of config/config.yml
# while developing so that the configuration can be shared and read safely.
#
# Copy this file to config/.env, beside config/config.yml in the folder git
# ignores, and fill it in, or into the folder LMCONMAN_CONFIG_DIR names. In
# production, put these values in config/config.yml instead, and do not use
# config/.env.
#
# db.password: the password of the role the running backend connects as:
LMCONMAN_DB_PASSWORD=
# db.adminpw: the password of the role that owns the schema:
LMCONMAN_DB_ADMINPW=
# auth.state_secret: signs the short-lived cookies used while someone signs in:
LMCONMAN_STATE_SECRET=
# connections.encryption_key: encrypts the keys of model connections:
LMCONMAN_CONNECTION_KEY=
# nextcloud.client_secret: from registering LMconman in Nextcloud; empty until then:
LMCONMAN_NEXTCLOUD_CLIENT_SECRET=
# nextcloud.client_id: from registering LMconman in Nextcloud; empty until then:
LMCONMAN_NEXTCLOUD_CLIENT_ID=
