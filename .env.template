# Development only: every secret AIconman needs, kept out of config/config.yml
# while developing so that the configuration can be shared and read safely.
#
# Copy this file to config/.env, beside config/config.yml in the folder git
# ignores, and fill it in. In production, put these values in config/config.yml
# instead, and do not use config/.env.
#
# db.password: the password of the role the running backend connects as:
AICONMAN_DB_PASSWORD=
# db.adminpw: the password of the role that owns the schema:
AICONMAN_DB_ADMINPW=
# auth.state_secret: signs the short-lived cookies used while someone signs in:
AICONMAN_STATE_SECRET=
# connections.encryption_key: encrypts the keys of model connections:
AICONMAN_CONNECTION_KEY=
# nextcloud.client_secret: from registering AIconman in Nextcloud; empty until then:
AICONMAN_NEXTCLOUD_CLIENT_SECRET=
# nextcloud.client_id: from registering AIconman in Nextcloud; empty until then:
AICONMAN_NEXTCLOUD_CLIENT_ID=
